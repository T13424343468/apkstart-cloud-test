<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TaoZip.PC.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TaoZip 1.0">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="16,12,16,4">
            <!-- v79: 占位圆豆换成程序真图标 (Assets/app-icon.png, 源自 Resources/app.ico 256 帧) -->
            <Image Width="28" Height="28" Source="ms-appx:///Assets/app-icon.png"/>
            <TextBlock Text="TaoZip" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Text="道法自然 · 收放自如" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
        </StackPanel>

        <!-- 工具栏: 按「先有包再操作」排序, 未打开压缩包时相关操作置灰 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="16,8,16,8">
            <Button x:Name="BtnOpen" Content="打开压缩包" Click="OnOpen"/>
            <Button x:Name="BtnExtract" Content="解压到…" Click="OnExtract" IsEnabled="False"/>
            <Button x:Name="BtnSmart" Content="智能解压" Click="OnSmartExtract" IsEnabled="False"/>
            <Button x:Name="BtnTest" Content="完整性测试" Click="OnTest" IsEnabled="False"/>
            <Button x:Name="BtnHistory" Content="历史记录" Click="OnHistory"/>
            <Button x:Name="BtnAssoc" Content="关联与右键" Click="OnFileAssoc"/>
            <!-- 主题三象: 水墨(系列默认)/天青/墨夜, 切换即时生效并记住 -->
            <ComboBox x:Name="CmbTheme" SelectionChanged="OnThemeChanged" MinWidth="92" VerticalAlignment="Center" Margin="8,0,0,0">
                <ComboBoxItem Content="水墨"/>
                <ComboBoxItem Content="天青"/>
                <ComboBoxItem Content="墨夜"/>
            </ComboBox>
        </StackPanel>

        <!-- 历史记录工具条: 仅历史模式可见 (v86: 搜索快速定位 + 批量清理) -->
        <StackPanel x:Name="HistoryBar" Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="16,0,16,8" Visibility="Collapsed">
            <TextBox x:Name="TxtHistSearch" PlaceholderText="搜索: 输入路径或操作关键词快速定位" MinWidth="300" TextChanged="OnHistSearchChanged"/>
            <Button x:Name="BtnHistClear" Content="清理全部" Click="OnHistClear"/>
            <Button x:Name="BtnHistPurge" Content="全部删除…" Click="OnHistPurge"/>
        </StackPanel>

        <!-- 内容列表: 空时以"虚"示人 (负阴抱阳), 有内容则提示退场;
             v62: 列表区自带层色底 (中间不再与页底同色隐形), 空态提示用次要字 (肉眼必可辨) -->
        <Grid Grid.Row="3" Margin="16,0,16,8">
            <ListView x:Name="ListMain"
                      Background="{ThemeResource LayerFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6"
                      AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
                      DoubleTapped="OnListDoubleTapped"/>
            <TextBlock x:Name="EmptyHint" Text="虚以待物 —— 拖入压缩包即查看，拖入文件即压缩"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsHitTestVisible="False"/>
        </Grid>
        <!-- 历史记录模式复用 ListMain; 每行自带删除按钮, 双击条目即打开所在目录 -->

        <!-- 状态栏 -->
        <Border Grid.Row="4" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="16,8,16,8">
            <TextBlock x:Name="StatusText" Text="准备就绪 —— 支持解压 zip / 7z / rar(仅解压) / tar / gz / bz2 / xz；压缩 zip / tar.gz" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Border>
    </Grid>
</Window>
