<?xml version="1.0" encoding="utf-8"?>
<!--
    墨夜深色调色板（Tao 系列统一，v59 亮度阶梯重设，v61 扁平化）：
    亮度阶梯底段——近黑为主（底 #131211），暖序签名 R>G>B 不失温度。
    宣纸白字 + 黛青点缀保留，对比更足。
    v61 病根：分段字典跟随系统基调，浅色系统的机器墨夜不生效。
    治本：扁平色板，不分段、永远生效；换肤三象互斥只挂当象，不再常驻应用级。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 底: 近黑夜, 以黑为主, 暖序不灭 -->
    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#131211" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#131211" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush" Color="#191715" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#1C1A18" />
    <SolidColorBrush x:Key="WindowCaptionBackgroundBrush" Color="#131211" />
    <SolidColorBrush x:Key="WindowCaptionBackgroundDisabledBrush" Color="#191715" />
    <SolidColorBrush x:Key="WindowCaptionForegroundBrush" Color="#E8E3D5" />
    <SolidColorBrush x:Key="WindowCaptionForegroundDisabledBrush" Color="#5C574C" />

    <!-- 字: 宣纸白系, 近黑上对比更足 -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#E8E3D5" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#ABA595" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#867F6F" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#5C574C" />

    <!-- 点缀: 黛青, 进度条/选中态/强调 -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#6FA3BC" />
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#3E4A50" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#93C2D8" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#6FA3BC" />

    <!-- 控件面: 近黑层次, 描边实色锁边界 -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#211E1B" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#2A2623" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#1B1917" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#6E675C" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#5C574C" />
    <Color x:Key="SystemAccentColor">#6FA3BC</Color>
    <Color x:Key="SystemAccentColorLight1">#85B1C6</Color>
    <Color x:Key="SystemAccentColorLight2">#9ABFD0</Color>
    <Color x:Key="SystemAccentColorLight3">#B0CCDA</Color>
    <Color x:Key="SystemAccentColorDark1">#5E8BA0</Color>
    <Color x:Key="SystemAccentColorDark2">#4E7284</Color>
    <Color x:Key="SystemAccentColorDark3">#3D5A67</Color>
    <SolidColorBrush x:Key="SystemAccentColorLight1Brush" Color="#85B1C6" />
    <SolidColorBrush x:Key="SystemAccentColorLight2Brush" Color="#9ABFD0" />
    <SolidColorBrush x:Key="SystemAccentColorLight3Brush" Color="#B0CCDA" />
    <SolidColorBrush x:Key="SystemAccentColorDark1Brush" Color="#5E8BA0" />
    <SolidColorBrush x:Key="SystemAccentColorDark2Brush" Color="#4E7284" />
    <SolidColorBrush x:Key="SystemAccentColorDark3Brush" Color="#3D5A67" />
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#6FA3BC" />
    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#6FA3BC" />
    <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="#6FA3BC" />
    <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush" Color="#6FA3BC" />
</ResourceDictionary>
