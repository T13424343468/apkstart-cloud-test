<?xml version="1.0" encoding="utf-8"?>
<!--
    天青主题（Tao 系列三象之二，2026-11-06 用户定稿对齐 TaoAgent 天青色板）：
    天青釉底（近白偏青，冷而不钢）——底 #EDF2EF，通道序 G>B>R（青瓷序）。
    墨青文字 #2B3A36，青瓷点缀 #34655C。
    v61 病根：分段字典跟随系统基调，深色系统机器浅色段不生效→黑底。
    治本：扁平色板，不分段、永远生效；换肤三象互斥只挂当象。
    2026-11-06 天青釉面：列表层/状态栏与按钮面走纵向釉面微渐变（上亮-主体-下暗），陶瓷质感。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 底: 天青釉面, 近白偏青 -->
    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#EDF2EF" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#EDF2EF" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush" Color="#E1E9E4" />
    <LinearGradientBrush x:Key="LayerFillColorDefaultBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFCFEFD" Offset="0.0" />
        <GradientStop Color="#FFFAFCFA" Offset="0.55" />
        <GradientStop Color="#FFEEF1F0" Offset="1.0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WindowCaptionBackgroundBrush" Color="#EDF2EF" />
    <SolidColorBrush x:Key="WindowCaptionBackgroundDisabledBrush" Color="#E1E9E4" />
    <SolidColorBrush x:Key="WindowCaptionForegroundBrush" Color="#2B3A36" />
    <SolidColorBrush x:Key="WindowCaptionForegroundDisabledBrush" Color="#64746E" />

    <!-- 字: 墨青系 (天青底上深字, 对比动态计算过线) -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#2B3A36" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#4A5A54" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#64746E" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#9AA8A1" />

    <!-- 点缀: 青瓷 (与水墨浓墨、墨夜黛青两两互异) -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#34655C" />
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#B4C0BA" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#34655C" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#43756B" />

    <!-- 控件面: 亮于底, 按钮面走釉面微渐变 (陶瓷质感), 描边锁边界 -->
    <LinearGradientBrush x:Key="ControlFillColorDefaultBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFEFE" Offset="0.0" />
        <GradientStop Color="#FFF3F8F4" Offset="0.55" />
        <GradientStop Color="#FFE7ECE9" Offset="1.0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#E7EDE8" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#DDE6DF" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#9FB0A7" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#AEBFB6" />
    <Color x:Key="SystemAccentColor">#34655C</Color>
    <Color x:Key="SystemAccentColorLight1">#4A7A70</Color>
    <Color x:Key="SystemAccentColorLight2">#6C968D</Color>
    <Color x:Key="SystemAccentColorLight3">#93B5AD</Color>
    <Color x:Key="SystemAccentColorDark1">#2C534C</Color>
    <Color x:Key="SystemAccentColorDark2">#234440</Color>
    <Color x:Key="SystemAccentColorDark3">#1A3430</Color>
    <SolidColorBrush x:Key="SystemAccentColorLight1Brush" Color="#4A7A70" />
    <SolidColorBrush x:Key="SystemAccentColorLight2Brush" Color="#6C968D" />
    <SolidColorBrush x:Key="SystemAccentColorLight3Brush" Color="#93B5AD" />
    <SolidColorBrush x:Key="SystemAccentColorDark1Brush" Color="#2C534C" />
    <SolidColorBrush x:Key="SystemAccentColorDark2Brush" Color="#234440" />
    <SolidColorBrush x:Key="SystemAccentColorDark3Brush" Color="#1A3430" />
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#34655C" />
    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#34655C" />
    <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="#34655C" />
    <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush" Color="#34655C" />
</ResourceDictionary>
