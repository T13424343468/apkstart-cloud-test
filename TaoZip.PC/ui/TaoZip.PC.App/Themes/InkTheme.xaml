<?xml version="1.0" encoding="utf-8"?>
<!--
    水墨主题（Tao 系列主题，默认自带，v64 全系同步用户定稿）：
    近白宣底（#FCFBF7/#FEFDFB/#ECEAE2，暖序保留）、浓墨字、深藏蓝点缀。
    v61 扁平化：不分 Light/Dark 段，永远生效，与系统基调脱钩。
    v64 同步（浅底系同色号，与天青互为浅底系）：点缀深藏蓝 #0F4C9E（天青改用青瓷 #34655C，两象点缀互异），
    正文深墨 #1C242C（天青改用墨青 #2B3A36，两象文字互异）；墨夜为同色相反白亮版。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 底色：近白宣纸（暖序 R>G>B 保留） -->
    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#FCFBF7" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FCFBF7" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush" Color="#ECEAE2" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FEFDFB" />
    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorDefaultBrush" Color="#ECEAE2" />
    <SolidColorBrush x:Key="WindowCaptionBackgroundBrush" Color="#FCFBF7" />
    <SolidColorBrush x:Key="WindowCaptionForegroundBrush" Color="#1C242C" />
    <SolidColorBrush x:Key="WindowCaptionForegroundDisabledBrush" Color="#8A8578" />
    <SolidColorBrush x:Key="WindowCaptionBackgroundDisabledBrush" Color="#F3F1EA" />

    <!-- 文字：深墨 / 淡墨 -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#1C242C" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#6F6A5E" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#8C867A" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#A8A296" />

    <!-- 点缀：深藏蓝（浅底系同色号, 与正文深墨拉开色相与亮度） -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0F4C9E" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#0F4C9E" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#0B3D6B" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#1A5FB0" />

    <!-- 控件：纸面与边界 -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FDFCF8" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#F5F2E8" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#A89F8C" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#B5AD99" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#D8D2C0" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#EAE5D6" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#E2DCC9" />
    <Color x:Key="SystemAccentColor">#0F4C9E</Color>
    <Color x:Key="SystemAccentColorLight1">#3367AD</Color>
    <Color x:Key="SystemAccentColorLight2">#5782BB</Color>
    <Color x:Key="SystemAccentColorLight3">#7B9DCA</Color>
    <Color x:Key="SystemAccentColorDark1">#0D4186</Color>
    <Color x:Key="SystemAccentColorDark2">#0A356F</Color>
    <Color x:Key="SystemAccentColorDark3">#082A57</Color>
    <SolidColorBrush x:Key="SystemAccentColorLight1Brush" Color="#3367AD" />
    <SolidColorBrush x:Key="SystemAccentColorLight2Brush" Color="#5782BB" />
    <SolidColorBrush x:Key="SystemAccentColorLight3Brush" Color="#7B9DCA" />
    <SolidColorBrush x:Key="SystemAccentColorDark1Brush" Color="#0D4186" />
    <SolidColorBrush x:Key="SystemAccentColorDark2Brush" Color="#0A356F" />
    <SolidColorBrush x:Key="SystemAccentColorDark3Brush" Color="#082A57" />
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#0F4C9E" />
    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#0F4C9E" />
    <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="#0F4C9E" />
    <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush" Color="#0F4C9E" />
</ResourceDictionary>
